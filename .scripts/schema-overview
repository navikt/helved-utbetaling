#!/usr/bin/env perl
# Generate a standalone HTML overview from PostgreSQL migration files.
# Uses only Perl core modules. Unsupported SQL is ignored.

use strict;
use warnings;
use File::Basename qw(basename);
use File::Spec;
use JSON::PP qw(encode_json);

sub usage { die "Usage: schema-overview MIGRATIONS_DIR [--output FILE]\n" }

my $directory = shift @ARGV // usage();
my $output;
if (@ARGV) {
    usage() unless @ARGV == 2 && $ARGV[0] eq '--output';
    $output = $ARGV[1];
}
usage() unless -d $directory;

my @files;
sub collect_sql {
    my ($path) = @_;
    opendir my $dir, $path or die "Cannot open $path: $!\n";
    for my $entry (readdir $dir) {
        next if $entry eq '.' || $entry eq '..';
        my $child = File::Spec->catfile($path, $entry);
        -d $child ? collect_sql($child) : push @files, $child if $child =~ /\.sql\z/i;
    }
    closedir $dir;
}
collect_sql($directory);
die "No .sql files found in: $directory\n" unless @files;

@files = sort {
    my ($an) = basename($a) =~ /^V(\d+)/i;
    my ($bn) = basename($b) =~ /^V(\d+)/i;
    ($an // 9_999_999_999) <=> ($bn // 9_999_999_999) || $a cmp $b;
} @files;

my (%tables, %columns, %indexes, @table_order, @unmodeled);
my $source = '';

sub trim { my $s = shift // ''; $s =~ s/^\s+|\s+$//g; return $s }
sub html { my $s = shift // ''; $s =~ s/&/&amp;/g; $s =~ s/</&lt;/g; $s =~ s/>/&gt;/g; $s =~ s/"/&quot;/g; return $s }
sub identifier {
    my $s = trim(shift);
    return substr($s, 1, -1) if $s =~ /^".*"$/;
    return lc $s;
}
sub remember_table {
    my ($name) = @_;
    return if exists $tables{$name};
    $tables{$name} = { source => basename($source), exists => 1, columns => [], primary_key => '' };
    push @table_order, $name;
}
sub split_top_level {
    my ($text) = @_;
    my @items;
    my ($start, $depth, $quote, $dollar) = (0, 0, '', '');
    for (my $i = 0; $i < length $text; $i++) {
        my $char = substr($text, $i, 1);
        if ($dollar ne '') {
            if (substr($text, $i, length $dollar) eq $dollar) { $i += length($dollar) - 1; $dollar = '' }
            next;
        }
        if ($quote ne '') {
            if ($char eq $quote) { $i++ if $quote eq q{'} && substr($text, $i + 1, 1) eq q{'}; $quote = '' }
            next;
        }
        if ($char eq q{'} || $char eq q{"}) { $quote = $char; next }
        if ($char eq '$' && substr($text, $i) =~ /^(\$[A-Za-z_][A-Za-z_0-9]*\$|\$\$)/) { $dollar = $1; $i += length($dollar) - 1; next }
        $depth++ if $char eq '(';
        $depth-- if $char eq ')';
        if ($char eq ',' && !$depth) { push @items, substr($text, $start, $i - $start); $start = $i + 1 }
    }
    push @items, substr($text, $start);
    return @items;
}
sub add_column {
    my ($table, $definition) = @_;
    $definition = trim($definition);
    $definition =~ s/^add\s+column\s+//i;
    if ($definition =~ /^primary\s+key\b/i) { $tables{$table}{primary_key} = $definition; return }
    return if $definition =~ /^(constraint|unique|check|foreign\s+key|exclude)\b/i;
    return unless $definition =~ /^((?:"[^"]+")|\S+)\s+(.+)\z/s;
    my ($name, $rest) = (identifier($1), $2);
    my ($type) = $rest =~ /^(.*?)(?=\s+(?:not\s+null|null|default|generated|primary\s+key|unique|references|check|constraint)\b|\z)/is;
    my ($default) = $rest =~ /\bdefault\s+(.+?)(?=\s+(?:generated|primary\s+key|unique|references|check|constraint)\b|\z)/is;
    my ($generated) = $rest =~ /(generated\s+always\s+as\s*\(.+\)\s*stored)/is;
    my $key = "$table\0$name";
    push @{ $tables{$table}{columns} }, $name unless exists $columns{$key};
    $columns{$key} = {
        type => trim($type), default => trim($default), generated => trim($generated),
        not_null => ($rest =~ /\bnot\s+null\b/i ? 1 : 0),
    };
    $tables{$table}{primary_key} = "PRIMARY KEY ($name)" if $rest =~ /\bprimary\s+key\b/i;
}
sub process {
    my ($statement) = @_;
    $statement = trim($statement);
    $statement =~ s/\s+/ /g;
    return if $statement eq '' || $statement =~ /^(begin|commit|rollback)\z/i;
    if ($statement =~ /^create\s+table\s+(?:if\s+not\s+exists\s+)?((?:"[^"]+")|[^\s(]+)\s*\((.*)\)\z/is) {
        my $table = identifier($1); remember_table($table); add_column($table, $_) for split_top_level($2); return;
    }
    if ($statement =~ /^drop\s+table\s+(?:if\s+exists\s+)?((?:"[^"]+")|[^\s;]+)/i) {
        my $table = identifier($1); $tables{$table}{exists} = 0 if exists $tables{$table}; return;
    }
    if ($statement =~ /^alter\s+table\s+((?:"[^"]+")|\S+)\s+add\s+column\s+(.+)\z/is) {
        my $table = identifier($1); remember_table($table); add_column($table, $_) for split_top_level($2); return;
    }
    if ($statement =~ /^alter\s+table\s+((?:"[^"]+")|\S+)\s+drop\s+column\s+(?:if\s+exists\s+)?((?:"[^"]+")|\S+)/i) {
        delete $columns{identifier($1) . "\0" . identifier($2)}; return;
    }
    if ($statement =~ /^alter\s+table\s+((?:"[^"]+")|\S+)\s+rename\s+column\s+((?:"[^"]+")|\S+)\s+to\s+((?:"[^"]+")|\S+)/i) {
        my ($table, $old, $new) = map identifier($_), ($1, $2, $3);
        my $old_key = "$table\0$old"; my $new_key = "$table\0$new";
        $columns{$new_key} = delete $columns{$old_key};
        for (@{ $tables{$table}{columns} }) { $_ = $new if $_ eq $old }
        return;
    }
    if ($statement =~ /^alter\s+table\s+((?:"[^"]+")|\S+)\s+alter\s+column\s+((?:"[^"]+")|\S+)\s+set\s+default\s+(.+)\z/is) {
        $columns{identifier($1) . "\0" . identifier($2)}{default} = trim($3); return;
    }
    if ($statement =~ /^create\s+(unique\s+)?index\s+(?:if\s+not\s+exists\s+)?((?:"[^"]+")|\S+)\s+on\s+((?:"[^"]+")|[^\s(]+)/i) {
        my ($name, $table) = map identifier($_), ($2, $3);
        $indexes{$name} = { table => $table, source => basename($source), definition => $statement }; return;
    }
    if ($statement =~ /^drop\s+index\s+(?:if\s+exists\s+)?((?:"[^"]+")|\S+)/i) { delete $indexes{identifier($1)}; return }
    push @unmodeled, basename($source) . ": " . $statement;
}
sub statements {
    my ($text) = @_;
    $text =~ s{--[^\n]*}{}g;
    my @result;
    my ($start, $quote, $dollar) = (0, '', '');
    for (my $i = 0; $i < length $text; $i++) {
        my $char = substr($text, $i, 1);
        if ($dollar ne '') { if (substr($text, $i, length $dollar) eq $dollar) { $i += length($dollar) - 1; $dollar = '' } next }
        if ($quote ne '') { if ($char eq $quote) { $i++ if $quote eq q{'} && substr($text, $i + 1, 1) eq q{'}; $quote = '' } next }
        if ($char eq q{'} || $char eq q{"}) { $quote = $char; next }
        if ($char eq '$' && substr($text, $i) =~ /^(\$[A-Za-z_][A-Za-z_0-9]*\$|\$\$)/) { $dollar = $1; $i += length($dollar) - 1; next }
        if ($char eq ';') { push @result, substr($text, $start, $i - $start); $start = $i + 1 }
    }
    push @result, substr($text, $start);
    return @result;
}
sub is_topic_table {
    my ($table) = @_;
    return $tables{$table}{exists} && $table !~ /^(timer|korrigerte?_feilet_utbetalinger|kjent_dobbeltutbetaling|kvittering|fk|oppdragsdata)$/;
}
sub topic_group {
    my ($table) = @_;
    return 'XML' if $table =~ /^(oppdrag|simuleringer)$/;
    return 'JSON';
}
sub column_signature {
    my ($table, $name) = @_;
    my $column = $columns{"$table\0$name"};
    return join "\x1e", map { normalized_sql($_) } ($name, $column->{type}, $column->{not_null}, $column->{default}, $column->{generated});
}
sub normalized_sql {
    my ($sql) = @_;
    $sql = trim($sql // '');
    my ($result, $quoted) = ('', '');
    for (my $i = 0; $i < length $sql; $i++) {
        my $character = substr($sql, $i, 1);
        if ($quoted ne '') {
            $result .= $character;
            if ($character eq $quoted) {
                if ($quoted eq q{'} && substr($sql, $i + 1, 1) eq q{'}) { $result .= substr($sql, ++$i, 1) }
                else { $quoted = '' }
            }
            next;
        }
        if ($character eq q{'} || $character eq q{"}) { $quoted = $character; $result .= $character; next }
        $result .= lc $character;
    }
    $result =~ s/\s+/ /g;
    return $result;
}
sub column_description {
    my ($table, $name) = @_;
    my $column = $columns{"$table\0$name"};
    return '' unless $column;
    my @details = ($column->{type});
    push @details, 'NOT NULL' if $column->{not_null};
    push @details, "DEFAULT $column->{default}" if $column->{default} ne '';
    push @details, $column->{generated} if $column->{generated} ne '';
    return join ' ', @details;
}
sub normalized_index_definition {
    my ($definition) = @_;
    my ($unique) = $definition =~ /^create\s+(unique\s+)?index\b/i;
    $unique //= '';
    $definition =~ s/^create\s+(?:unique\s+)?index\s+(?:if\s+not\s+exists\s+)?(?:"[^"]+"|\S+)\s+on\s+(?:"[^"]+"|\S+)\s*/$unique/i;
    return normalized_sql($definition);
}
sub index_signature {
    my ($table) = @_;
    return join "\x1d", sort map { normalized_index_definition($indexes{$_}{definition}) } grep { $indexes{$_}{table} eq $table } keys %indexes;
}
sub table_signature {
    my ($table) = @_;
    my @columns = map { column_signature($table, $_) } grep { exists $columns{"$table\0$_"} } @{ $tables{$table}{columns} };
    return join "\x1f", join("\x1e", @columns), normalized_sql($tables{$table}{primary_key}), index_signature($table);
}
sub difference_list {
    my ($table, $baseline) = @_;
    my (%table_columns, %baseline_columns);
    $table_columns{$_} = column_signature($table, $_) for grep { exists $columns{"$table\0$_"} } @{ $tables{$table}{columns} };
    $baseline_columns{$_} = column_signature($baseline, $_) for grep { exists $columns{"$baseline\0$_"} } @{ $tables{$baseline}{columns} };
    my @result;
    push @result, 'Only in this table - column: ' . $_ for sort grep { !exists $baseline_columns{$_} } keys %table_columns;
    push @result, 'Only in reference - column: ' . $_ for sort grep { !exists $table_columns{$_} } keys %baseline_columns;
    push @result, 'Different definition - column: ' . $_ for sort grep { exists $baseline_columns{$_} && $table_columns{$_} ne $baseline_columns{$_} } keys %table_columns;
    push @result, 'Different definition - primary key' if normalized_sql($tables{$table}{primary_key}) ne normalized_sql($tables{$baseline}{primary_key});
    my (%table_indexes, %baseline_indexes);
    $table_indexes{$_} = 1 for split /\x1d/, index_signature($table);
    $baseline_indexes{$_} = 1 for split /\x1d/, index_signature($baseline);
    push @result, 'Only in this table - index: ' . $_ for sort grep { $_ ne '' && !exists $baseline_indexes{$_} } keys %table_indexes;
    push @result, 'Only in reference - index: ' . $_ for sort grep { $_ ne '' && !exists $table_indexes{$_} } keys %baseline_indexes;
    return @result;
}

for my $file (@files) {
    $source = $file;
    open my $fh, '<', $file or die "Cannot read $file: $!\n";
    local $/; my $sql = <$fh>; close $fh;
    process($_) for statements($sql);
}

my (@topic_tables, %matches_baseline, %table_differences, %baseline_by_group);
@topic_tables = grep { is_topic_table($_) } @table_order;
for my $group ('XML', 'JSON') {
    my @group_tables = grep { topic_group($_) eq $group } @topic_tables;
    my ($baseline, $fewest_differences) = ('', undef);
    for my $candidate (@group_tables) {
        my $difference_count = 0;
        for my $other (@group_tables) {
            next if $candidate eq $other;
            $difference_count += scalar difference_list($candidate, $other);
        }
        if (!defined($fewest_differences) || $difference_count < $fewest_differences || ($difference_count == $fewest_differences && ($candidate cmp $baseline) < 0)) {
            ($baseline, $fewest_differences) = ($candidate, $difference_count);
        }
    }
    $baseline_by_group{$group} = $baseline;
}
for my $table (@table_order) {
    next unless is_topic_table($table);
    my $baseline = $baseline_by_group{topic_group($table)};
    my $baseline_signature = table_signature($baseline);
    $matches_baseline{$table} = table_signature($table) eq $baseline_signature;
    $table_differences{$table} = [ difference_list($table, $baseline) ] unless $matches_baseline{$table};
}

if (defined $output) { open STDOUT, '>', $output or die "Cannot write $output: $!\n" }
print <<'HTML';
<!doctype html>
<html lang="en">
