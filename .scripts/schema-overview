print qq{<section class="manual-compare">\n<h2>Compare any two tables</h2>\n<p>Select a left and right table. Rows align by name; highlighted rows are the only differences.</p>\n<div class="compare-controls"><label>Left table<select id="left-table"></select></label><button type="button" id="swap-tables">Swap sides</button><label>Right table<select id="right-table"></select></label></div><div class="compare-result" id="compare-result"></div>\n</section>\n};
my %comparison_data;
for my $table (@table_order) {
    next unless $tables{$table}{exists};
    my %table_columns;
    for my $name (@{ $tables{$table}{columns} }) {
        next unless exists $columns{"$table\0$name"};
        $table_columns{$name} = {
            display => column_description($table, $name),
            normalized => column_signature($table, $name),
        };
    }
    my @table_indexes = map {
        {
            name => $_,
            display => $indexes{$_}{definition},
            normalized => normalized_index_definition($indexes{$_}{definition}),
        }
    } sort grep { $indexes{$_}{table} eq $table } keys %indexes;
    my %column_definitions;
    for my $name (keys %table_columns) {
        my $column = $columns{"$table\0$name"};
        my @parts = ($name, $column->{type});
        push @parts, 'NOT NULL' if $column->{not_null};
        push @parts, "DEFAULT $column->{default}" if $column->{default} ne '';
        push @parts, $column->{generated} if $column->{generated} ne '';
        $column_definitions{$name} = join ' ', @parts;
    }
    $comparison_data{$table} = {
        columns => \%table_columns,
        column_definitions => \%column_definitions,
        indexes => \@table_indexes,
        primary_key => $tables{$table}{primary_key},
        normalized_primary_key => normalized_sql($tables{$table}{primary_key}),
    };
}
my $comparison_json = encode_json(\%comparison_data);
print "<script>\nconst schemaTables = $comparison_json;\n";
print <<'HTML';
HTML
print <<'JAVASCRIPT';
const leftSelect = document.querySelector('#left-table');
const rightSelect = document.querySelector('#right-table');
const result = document.querySelector('#compare-result');
const escapeHtml = value => String(value).replace(/[&<>"']/g, character => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character]);
const status = (left, right) => !left ? 'only-left' : !right ? 'only-right' : left.normalized !== right.normalized ? 'definition-diff' : '';
const indexMap = table => Object.fromEntries(table.indexes.map(index => [index.normalized, index]));
const quoteIdentifier = value => String(value);
const indexNameFor = (rightTable, leftIndexName) => `${rightTable}_${leftIndexName}`.slice(0, 63);
function createIndexSql(index, leftName, rightName) {
    const indexName = indexNameFor(rightName, index.name);
    return index.display
        .replace(/^(create\s+(?:unique\s+)?index\s+)(?:"[^"]+"|\S+)/i, `$1${quoteIdentifier(indexName)}`)
        .replace(new RegExp(`\\bon\\s+${leftName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\b`, 'i'), `ON ${quoteIdentifier(rightName)}`);
}
function syncSql(leftName, left, rightName, right) {
    const statements = [`-- Review before running. This SQL changes ${quoteIdentifier(rightName)} to match ${quoteIdentifier(leftName)}.`, '-- Add columns present only on the left.'];
    const commonColumns = Object.keys(left.columns).filter(name => right.columns[name]);
    for (const name of Object.keys(left.columns).sort()) if (!right.columns[name]) statements.push(`ALTER TABLE ${quoteIdentifier(rightName)} ADD COLUMN ${left.column_definitions[name]};`);
    const changedColumns = commonColumns.filter(name => left.columns[name].normalized !== right.columns[name].normalized);
    if (changedColumns.length) {
        statements.push('', '-- DESTRUCTIVE: recreate columns whose definitions differ. Existing values in these columns are lost.');
        for (const name of changedColumns.sort()) statements.push(`ALTER TABLE ${quoteIdentifier(rightName)} DROP COLUMN ${quoteIdentifier(name)};\nALTER TABLE ${quoteIdentifier(rightName)} ADD COLUMN ${left.column_definitions[name]};`);
    }
    if (left.normalized_primary_key !== right.normalized_primary_key) {
        statements.push('', '-- DESTRUCTIVE: replace the primary key. Verify constraint name and data first.', `ALTER TABLE ${quoteIdentifier(rightName)} DROP CONSTRAINT ${quoteIdentifier(`${rightName}_pkey`)};`, `ALTER TABLE ${quoteIdentifier(rightName)} ADD ${left.primary_key};`);
    }
    const leftIndexes = indexMap(left); const rightIndexes = indexMap(right);
    const leftOnlyIndexes = Object.keys(leftIndexes).filter(signature => !rightIndexes[signature]);
    if (leftOnlyIndexes.length) {
        statements.push('', '-- Add indexes present only on the left. Generated index names are prefixed with the right table name.');
        for (const signature of leftOnlyIndexes.sort()) statements.push(createIndexSql(leftIndexes[signature], leftName, rightName) + ';');
    }
    const rightOnlyColumns = Object.keys(right.columns).filter(name => !left.columns[name]);
    const rightOnlyIndexes = Object.keys(rightIndexes).filter(signature => !leftIndexes[signature]);
    if (rightOnlyColumns.length || rightOnlyIndexes.length) {
        statements.push('', '-- OPTIONAL AND DESTRUCTIVE: remove items that exist only on the right. Uncomment after review.');
        for (const signature of rightOnlyIndexes.sort()) statements.push(`-- DROP INDEX ${quoteIdentifier(rightIndexes[signature].name)};`);
        for (const name of rightOnlyColumns.sort()) statements.push(`-- ALTER TABLE ${quoteIdentifier(rightName)} DROP COLUMN ${quoteIdentifier(name)};`);
    }
    return statements.join('\n');
}
function renderTable(name, table, other, side) {
    const indexes = indexMap(table); const otherIndexes = indexMap(other);
    const columnRows = Object.keys(table.columns).sort().map(columnName => {
        const column = table.columns[columnName]; const otherColumn = other.columns[columnName];
        const rowStatus = status(column, otherColumn);
        return `<tr class="${rowStatus}"><td><code>${escapeHtml(columnName)}</code></td><td><code>${escapeHtml(column.display)}</code></td></tr>`;
    }).join('') || '<tr><td colspan="2"><em>No columns</em></td></tr>';
    const primaryKeyClass = table.normalized_primary_key === other.normalized_primary_key ? '' : 'definition-diff';
    const indexRows = Object.keys(indexes).sort().map(signature => {
        const index = indexes[signature]; const rowStatus = otherIndexes[signature] ? '' : side === 'left' ? 'only-left' : 'only-right';
